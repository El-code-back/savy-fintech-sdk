# Server only. Create a key at https://console.groq.com/keys
# Put it in .env.local locally, or in Vercel Environment Variables.
# Never use a VITE_ prefix for a private API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Alternative: use an already installed Ollama model on this computer.
# This mode is for local development only; Vercel needs a cloud API key.
AI_PROVIDER=groq
OLLAMA_MODEL=mistral:latest
